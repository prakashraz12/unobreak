NODE_ENV=development
PORT=3001

DATABASE_URL="postgresql://uno_user:uno_dev_password@localhost:5432/uno_game?schema=public"
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
DATABASE_LOGGING=false

